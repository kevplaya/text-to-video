# Google Gemini API Key (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# HuggingFace Token (Required for Stable Diffusion)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ElevenLabs API Key (Optional - for high-quality TTS)
# Get your API key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Grok (xAI) API Key (Optional - for Grok image/video generation)
# Get your API key from: https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# Kling AI API Key (Optional - for Kling video generation)
# Get from: https://app.klingai.com/
KLING_API_KEY=your_kling_api_key_here
KLING_API_SECRET=your_kling_api_secret_here

# OpenAI GPT API Key (Optional - for character DNA extraction via GPT-4o)
# Get from: https://platform.openai.com/
GPT_API_KEY=your_openai_api_key_here
